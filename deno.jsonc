{
  "tasks": {
    // Watch mode or HMR for development
    "dev": "deno run --allow-net --allow-read --allow-run scripts/dev.ts",

    // Just build the project, no watch mode, for production build
    // - For development: using with `deno task serve`
    "build": "rm -rf dist/ && deno task build:index && deno task build:data-manipulator && deno task build:404 && deno task build:history && deno task postprocessing",
    "build:index": "deno bundle src/index.html --platform=browser --outdir dist/",
    "build:data-manipulator": "deno bundle src/data-manipulator.html --platform=browser --outdir dist/",
    "build:404": "deno bundle src/404.html --platform=browser --outdir dist/",
    "build:history": "deno bundle src/history.html --platform=browser --outdir dist/",
    "serve": "deno run --allow-net --allow-read jsr:@std/http/file-server",

    // Copy the assets to the dist directory
    "copy:favicon": "deno run --allow-read --allow-write scripts/copy_favicon_images.ts",
    "copy:images": "cp -r src/showcase_images dist",
    "copy:css": "cp -r src/css dist",
    // The encoder Wasm is served as a file: `deno bundle` inlines the JS glue
    // but never emits the Wasm those packages load with `new URL(...)`.
    "copy:encoder-wasm": "cp -r src/assets/jsquash dist",
    // Third-party license texts, reachable from the deployed site
    "copy:licenses": "cp -r src/licenses dist",
    "bulk-copy": "deno task copy:favicon && deno task copy:images && deno task copy:css && deno task copy:encoder-wasm && deno task copy:licenses",

    // Maintenance: refresh the vendored encoder Wasm and license texts from the
    // pinned packages. Run after changing their versions in `imports`.
    "vendor:jsquash": "deno run --allow-read --allow-write --allow-env scripts/vendor_jsquash.ts",

    // Necessary post-processing tasks after building the project, both dev and production builds
    "postprocessing": "deno task bulk-copy && cp dist/index.html dist/index-raw.html",

    // Verification tasks apply to the whole project.
    // tests/fixtures/* are byte-exact copies that must never be reformatted.
    "test": "deno test --allow-read tests/",
    "check": "deno check tests/ src/ scripts/ functions/ netlify/ server/",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "fmt": {
    // Byte-exact files: fixture data, and the vendored third-party license
    // texts, which must stay identical to the packages they were copied from.
    // The showcase SVGs are golden renderings: their exact bytes are what the
    // golden tests compare against, so the formatter must not touch them.
    "exclude": [
      "tests/fixtures/*.json",
      "tests/fixtures/*.svg",
      "src/licenses/*.md"
    ]
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["dom", "dom.iterable", "dom.asynciterable", "deno.ns"]
  },
  "imports": {
    // Test-only imports
    "@std/assert": "jsr:@std/assert@^1.0.1",
    // Decoders, to verify in tests that an encoded file decodes back to the
    // exact pixels the renderer produced. Never imported by src/, so neither
    // package reaches the shipped bundle.
    "@jsquash/png": "npm:@jsquash/png@^3.1.1",
    "@jsquash/webp-decode": "npm:@jsquash/webp@^1.5.0/decode.js",

    // Straightlines codec: published package.
    "@tksh/stln-codec": "jsr:@tksh/stln-codec@^0.1.1",

    // Shared group-color parameter codec (URL/state shortening + expansion).
    "@tksh/group-colors-param-codec": "jsr:@tksh/group-colors-param-codec@^0.1.1",

    // Color-space conversion: sRGB <-> OKLCH, plus CSS Color 4 gamut mapping.
    // The "fn" entry is Color.js's tree-shakeable procedural API. Color.js
    // registers no color space by default; color-formatter/colorjs-spaces
    // registers the two spaces the app converts between.
    "colorjs.io/fn": "npm:colorjs.io@0.7.1/fn",

    // index.html specific imports
    "alwan": "npm:alwan@^2.3.1",
    "@timepp/murmurhash": "jsr:@timepp/murmurhash@^0.1.1",

    "init/adjust-layout": "./src/js/page-specific/index/init/adjust-layout.ts",
    "init/initial-opacity-steps": "./src/js/page-specific/index/init/initial-opacity-steps.ts",
    "init/tab-setup": "./src/js/page-specific/index/init/tab-setup.ts",

    "state/apply-url-state": "./src/js/page-specific/index/state/apply-url-state.ts",
    "state/image-format": "./src/js/page-specific/index/state/image-format.ts",
    "state/image-encoder": "./src/js/page-specific/index/state/image-encoder.ts",
    "state/resvg-option": "./src/js/page-specific/index/state/resvg-option.ts",
    "state/url-decode": "./src/js/page-specific/index/state/url-decode.ts",
    "state/url-state-manager": "./src/js/page-specific/index/state/url-state-manager.ts",

    "modal/modal-toggle": "./src/js/page-specific/index/modal/modal-toggle.ts",
    "modal/optimize-svg": "./src/js/page-specific/index/modal/optimize-svg.ts",
    "modal/reset-settings": "./src/js/page-specific/index/modal/reset-settings.ts",

    // SVG rasterizer: returns pixels only. The image file encoders are separate.
    "@denext/photon": "jsr:@denext/photon@^0.3.6",
    "svg2ui8a": "jsr:@tksh/svg2ui8a@^0.5.0/svg2rgba",
    // Encoder glue, imported statically. The packages' own wrapper modules
    // reach the same glue through `import()`, and `deno bundle` emits every
    // dynamic import as a separate chunk whose path a static host may not
    // publish. The `.js` extension is required: the packages declare no
    // `exports` map.
    // `jsquash/webp-encode` is used only by tests, to show that WebP is not
    // lossless without `exact`.
    "jsquash/webp-encode": "npm:@jsquash/webp@^1.5.0/encode.js",
    "jsquash/webp-enc": "npm:@jsquash/webp@^1.5.0/codec/enc/webp_enc.js",
    "jsquash/webp-enc-simd": "npm:@jsquash/webp@^1.5.0/codec/enc/webp_enc_simd.js",
    "jsquash/webp-meta": "npm:@jsquash/webp@^1.5.0/meta.js",
    "jsquash/webp-utils": "npm:@jsquash/webp@^1.5.0/utils.js",
    "jsquash/oxipng-glue": "npm:@jsquash/oxipng@^2.3.0/codec/pkg/squoosh_oxipng.js",
    "jsquash/oxipng-meta": "npm:@jsquash/oxipng@^2.3.0/meta.js",

    "tab-lines/apply-group-colors": "./src/js/page-specific/index/tab-lines/apply-group-colors.ts",
    "tab-lines/color-format": "./src/js/page-specific/index/tab-lines/color-format.ts",
    "tab-lines/details-toggle-listener": "./src/js/page-specific/index/tab-lines/details-toggle-listener.ts",
    "tab-lines/decode-colors-as-array": "./src/js/page-specific/index/tab-lines/decode-colors-as-array.ts",
    "tab-lines/encode-colors-as-hex": "./src/js/page-specific/index/tab-lines/encode-colors-as-hex.ts",
    "tab-lines/group-colors-listener": "./src/js/page-specific/index/tab-lines/group-colors-listener.ts",
    "tab-lines/group-colors-generator": "./src/js/page-specific/index/tab-lines/group-colors-generator.ts",
    "tab-lines/opacity-steps": "./src/js/page-specific/index/tab-lines/opacity-steps.ts",
    "tab-lines/path-mode": "./src/js/page-specific/index/tab-lines/path-mode.ts",
    "tab-lines/update-svg-color-format": "./src/js/page-specific/index/tab-lines/update-svg-color-format.ts",

    "tab-canvas/crop-side-margins": "./src/js/page-specific/index/tab-canvas/crop-side-margins.ts",
    "tab-canvas/shape-to-trim": "./src/js/page-specific/index/tab-canvas/shape-to-trim.ts",
    "tab-canvas/shape-to-trim-listener": "./src/js/page-specific/index/tab-canvas/shape-to-trim-listener.ts",

    "tab-render/height-pixel-size": "./src/js/page-specific/index/tab-render/height-pixel-size.ts",
    "tab-render/image-format": "./src/js/page-specific/index/tab-render/image-format.ts",
    "tab-render/shape-rendering": "./src/js/page-specific/index/tab-render/shape-rendering.ts",
    "tab-render/sync-number-and-range": "./src/js/page-specific/index/tab-render/sync-number-and-range.ts",

    "tab-ui/checkerboard-bg": "./src/js/page-specific/index/tab-ui/checkerboard-bg.ts",
    "tab-ui/text-wrapping": "./src/js/page-specific/index/tab-ui/text-wrapping.ts",
    "tab-ui/theme-color": "./src/js/page-specific/index/tab-ui/theme-color.ts",
    "tab-ui/view-scaling": "./src/js/page-specific/index/tab-ui/view-scaling.ts",

    "group-colors-svg/group-colors-svg": "./src/js/group-colors-svg/group-colors-svg.ts",
    "utils/number-rounding": "./src/js/page-specific/index/utils/number-rounding.ts",

    "button/copy-to-clipboard": "./src/js/page-specific/index/button/copy-to-clipboard.ts",
    "button/download-as-file": "./src/js/page-specific/index/button/download-as-file.ts",
    "button/init-download-buttons": "./src/js/page-specific/index/button/init-download-buttons.ts",
    "button/update-button-text": "./src/js/page-specific/index/button/update-button-text.ts",

    "shared-image/canonical-image-input": "./src/js/page-specific/index/shared-image/canonical-image-input.ts",
    "shared-image/constants": "./src/js/page-specific/index/shared-image/constants.ts",
    "shared-image/generate-and-upload": "./src/js/page-specific/index/shared-image/generate-and-upload.ts",
    "shared-image/shared-image-key": "./src/js/page-specific/index/shared-image/shared-image-key.ts",

    "history/theme-color": "./src/js/page-specific/history/theme-color.ts",

    "svg-to-png": "./src/js/page-specific/index/svg-to-png.ts",

    // data-manipulator.html specific imports
    // (display helpers for the stln-codec-based encode adapters)
    "encode/show-best-mix-result": "./src/js/encode-and-decode/encode/show-best-mix-result.ts",
    "encode/show-result": "./src/js/encode-and-decode/encode/show-result.ts",

    "io/copy-textarea": "./src/js/page-specific/data-manipulator/io/copy-textarea.ts",
    "io/download-url-params": "./src/js/page-specific/data-manipulator/io/download-url-params.ts",
    "io/select-file": "./src/js/page-specific/data-manipulator/io/select-file.ts",
    "data-manipulator/encode-adapters": "./src/js/page-specific/data-manipulator/encode-adapters.ts",

    // Common imports for both index.html and data-manipulator.html
    "@std/collections/zip": "jsr:@std/collections@^1.3.0/zip",
    "@std/encoding/base64": "jsr:@std/encoding@^1.0.11/base64",
    "@std/encoding/base64url": "jsr:@std/encoding@^1.0.11/base64url",
    "@std/streams/text-line-stream": "jsr:@std/streams@^1.1.2/text-line-stream",

    "constants": "./src/js/constants.ts",

    "common-utils/compression-stream": "./src/js/common-utils/compression-stream.ts",
    "common-utils/format-as-float": "./src/js/common-utils/format-as-float.ts",
    "common-utils/is-non-empty": "./src/js/common-utils/is-non-empty.ts",
    "common-utils/output-to-textarea": "./src/js/common-utils/output-to-textarea.ts",
    "common-utils/read-textarea": "./src/js/common-utils/read-textarea.ts",
    "common-utils/read-url-params": "./src/js/common-utils/read-url-params.ts",
    "common-utils/select-output-textarea": "./src/js/common-utils/select-output-textarea.ts",
    "common-utils/show-processing-time": "./src/js/common-utils/show-processing-time.ts",

    "color-formatter/format-converter": "./src/js/color-formatter/format-converter.ts",
    "color-formatter/normalized-from-hex": "./src/js/color-formatter/normalized-from-hex.ts",
    "color-formatter/normalized-to-hex": "./src/js/color-formatter/normalized-to-hex.ts",
    "color-formatter/colorjs-spaces": "./src/js/color-formatter/colorjs-spaces.ts",
    "color-formatter/rgb-to-oklch": "./src/js/color-formatter/rgb-to-oklch.ts",
    "color-formatter/oklch-to-rgb": "./src/js/color-formatter/oklch-to-rgb.ts",
    "color-formatter/rgb-to-lch": "./src/js/color-formatter/rgb-to-lch.ts"
  }
}
